---
import { brand } from '../data/site.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description,
  image = '/img/cover-office.jpg',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex, nofollow">}

<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:locale" content="en_GB">
<meta property="og:site_name" content={brand.name}>
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/img/logo.svg" type="image/svg+xml">
<meta name="theme-color" content="#0E1116">

<style is:global>
:root{
  --bg:#0E1116;
  --surf:#171C23;
  --surf2:#1D232B;
  --line:#232A33;
  --tx:#E8EDF2;
  --mut:#8D99A6;
  --acc:#34C77B;
  --acc-d:#25A863;
  --acc2:#8B7FD4;
  --btntx:#08130D;
  --rad:14px;
  --maxw:1240px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
html,body{max-width:100%;overflow-x:hidden}
body{background:var(--bg);color:var(--tx);line-height:1.62;font-size:16.5px;
  font-family:'Segoe UI',system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
img,svg{max-width:100%}
img{display:block}
a{color:inherit;text-decoration:none}
::selection{background:var(--acc);color:var(--btntx)}

.wrap{max-width:var(--maxw);margin:0 auto;padding:0 26px}
.sec{padding:74px 0}
.sec.tight{padding:52px 0}
.sec.alt{background:var(--surf);border-top:1px solid var(--line);
  border-bottom:1px solid var(--line)}

h1,h2,h3,h4{letter-spacing:-.022em;line-height:1.14;font-weight:800}
h1{font-size:clamp(32px,5vw,53px)}
h2{font-size:clamp(26px,3.6vw,38px)}
h3{font-size:19px;line-height:1.3}
p{margin:0 0 15px}
p:last-child{margin-bottom:0}

.eyebrow{font-size:12.5px;letter-spacing:.19em;text-transform:uppercase;
  color:var(--acc2);font-weight:800;margin-bottom:16px}
.eyebrow.g{color:var(--acc)}
.lead{font-size:18px;line-height:1.62;color:var(--mut)}
.mut{color:var(--mut)}
.g{color:var(--acc)}
.sechead{max-width:760px;margin-bottom:34px}
.sechead p{margin-top:14px;font-size:17.5px;color:var(--mut)}

.btn{display:inline-block;background:var(--acc);color:var(--btntx);
  padding:15px 28px;border-radius:10px;font-weight:800;font-size:16px;
  transition:.16s;border:0;cursor:pointer;font-family:inherit}
.btn:hover{background:var(--acc-d)}
.btn.ghost{background:transparent;color:var(--tx);border:1px solid var(--line)}
.btn.ghost:hover{border-color:var(--acc);background:transparent}

.card{background:var(--surf);border:1px solid var(--line);border-radius:var(--rad);
  padding:26px}
.card.hov{transition:.16s}
.card.hov:hover{border-color:var(--acc);transform:translateY(-2px)}
.sec.alt .card{background:var(--surf2)}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}

.tick{list-style:none;display:flex;flex-direction:column;gap:12px}
.tick li{padding-left:27px;position:relative;color:var(--tx)}
.tick li::before{content:"";position:absolute;left:2px;top:9px;width:9px;height:9px;
  border-radius:3px;background:var(--acc)}
.tick.pv li::before{background:var(--acc2)}

.pills{display:flex;gap:9px;flex-wrap:wrap}
.pill{border:1px solid var(--line);border-radius:999px;padding:7px 15px;
  font-size:13.5px;font-weight:700;color:var(--mut);background:var(--surf)}

.photo{border-radius:var(--rad);background-size:cover;background-position:center;
  border:1px solid var(--line)}

@media(max-width:900px){
  .grid3,.grid4,.grid2{grid-template-columns:1fr}
  .sec{padding:52px 0}
}
</style>
</head>
<body>
<Header />
<main>
  <slot />
</main>
<Footer />
</body>
</html>
