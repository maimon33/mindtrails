# Contact Form Terraform Variables Template
# Copy this file to terraform.tfvars and fill in your values
# Then add terraform.tfvars to .gitignore

# Admin email address for contact form notifications
# Must be a valid email address
admin_email = "admin@mindtrails.net"

# hCaptcha secret key for form submission validation
# Get this from your hCaptcha dashboard: https://dashboard.hcaptcha.com
hcaptcha_secret_key = "your-hcaptcha-secret-key-here"

# S3 bucket name for storing contact form submissions
# Must be globally unique, 3-63 characters, lowercase letters, numbers, hyphens
s3_bucket_name = "mindtrails-contact-submissions"

# Rate limit period in minutes
# How long to wait before allowing another submission from the same email
# Default: 60 (1 hour), Range: 1-1440 (1 minute to 24 hours)
rate_limit_minutes = 60

# Email address to use as sender for contact form notifications
# Must be SES verified in AWS
# Default: "contact@mindtrails.net"
sender_email = "contact@mindtrails.net"

# Environment name (prod, staging, dev)
# Used for resource naming and tagging
# Default: "prod"
environment = "prod"
